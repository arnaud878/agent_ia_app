# URL du serveur Nest (ia_back)
VITE_API_BASE=http://localhost:3000
# Même segment que N8N_WEBHOOK_PATH_SEGMENT dans ia_back/.env (chemin d’intégration n8n)
VITE_N8N_WEBHOOK_PATH_SEGMENT=5a2715bd-0b56-4e05-9c24-eb48e13c5d7a
# Même chaîne que API_CONFIG_SECRET dans ia_back/.env
VITE_X_API_CONFIG=
# Identifiant stable pour l’utilisateur (champ userId du webhook)
VITE_USER_ID=demo-user

# Note : le chatId est généré côté navigateur (session) et recréé à chaque
# « Nouvelle conversation » — il n’y a pas de variable d’environnement pour ça.
